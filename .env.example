# Environment Configuration Example for Applications Using Vital Agent Container SDK
# Copy this file to .env in your application and update with your actual values

# Logging Configuration
LOG_LEVEL=INFO

# WebSocket Lifecycle (seconds; 0 disables with a startup warning; empty or unset uses the default)
# Close a connection (1000) after this long with no handler running
WS_IDLE_TIMEOUT_SECONDS=300
# Close (4008) and cancel a handler that runs longer than this (backstop for handler deadlines)
WS_TASK_TIMEOUT_SECONDS=600
