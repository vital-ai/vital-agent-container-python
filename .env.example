# Environment Configuration Example for Applications Using Vital Agent Container SDK
# Copy this file to .env in your application and update with your actual values

# Logging Configuration
LOG_LEVEL=INFO

# WebSocket Lifecycle (seconds; 0 or empty disables)
# Close a connection with no messages and no handler running
WS_IDLE_TIMEOUT_SECONDS=300
# Cancel a handler that runs longer than this (backstop for the handler's own deadlines)
WS_TASK_TIMEOUT_SECONDS=600
