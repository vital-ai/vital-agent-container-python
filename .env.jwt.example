# JWT Configuration for Vital Agent Container
# Copy this file to .env and configure according to your environment

# Enable/disable JWT enforcement
JWT_ENABLED=true

# JWT Secret Key (for HS256 algorithm)
# Generate a strong secret key for production use
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# JWT Public Key Configuration (for RS256 algorithm)
# Option 1: Use local public key file
# JWT_PUBLIC_KEY_PATH=/path/to/public/key.pem

# Option 2: Use JWKS URL to fetch keys dynamically (recommended for production)
# JWT_JWKS_URL=https://your-auth-provider.com/.well-known/jwks.json

# JWT Algorithm (HS256 or RS256)
JWT_ALGORITHM=HS256

# JWT Enforcement Mode
# Options: none, header, payload
# - none: No JWT enforcement
# - header: JWT required in Authorization or x-jwt-token headers
# - payload: JWT required in message payload
JWT_ENFORCEMENT_MODE=header

# JWT Audience (optional)
# Expected audience value in JWT tokens - leave empty to skip audience validation
# JWT_AUDIENCE=your-api-identifier

# Required JWT Claims (comma-separated)
# These claims must be present in all JWT tokens
JWT_REQUIRED_CLAIMS=sub,exp,iat

# Custom JWT Claims (comma-separated)
# Additional claims to validate if present
JWT_CUSTOM_CLAIMS=user_id,permissions,role

# JWT Token Expiration Tolerance (seconds)
# Allow some clock skew between systems
JWT_LEEWAY=30

# Example JWT Payload Structure:
# For header-based authentication (single JWT):
# {
#   "sub": "user-123",
#   "exp": 1234567890,
#   "iat": 1234567890,
#   "kid": "key-id-123",        // Required for JWKS URL validation
#   "user_id": "user-123",
#   "permissions": ["read", "write"],
#   "role": "admin"
# }
#
# For payload-based authentication (dual JWT in message):
# {
#   "jwt_token": "eyJ...",      // Service-to-service transport JWT
#   "jwt_auth_token": "eyJ..."  // User authentication JWT
# }
#
